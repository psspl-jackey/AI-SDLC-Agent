# Which model runs the agents: "ollama" (free, local) or "anthropic" (Claude, paid)
MODEL_PROVIDER=ollama

# Local model through Ollama (https://ollama.com). Pull it first: ollama pull qwen2.5:14b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b

# Claude, used only when MODEL_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Cost meter, USD per million tokens (0 for the local model)
COST_INPUT_PER_MTOK=0
COST_OUTPUT_PER_MTOK=0

# Where projects and traces are stored
DATA_DIR=./data
MAX_TOKENS=4096

# Stage 3 estimate: risk buffer added on top of expected hours (reviewed at Gate 2)
RISK_BUFFER_PCT=15

# Stage 6 plan. JIRA_PROJECT_KEY is a placeholder until the real key is known.
# Capacity is the team's total working hours per sprint (e.g. 3 people x 80 h); reviewed by the tech lead.
JIRA_PROJECT_KEY=SDLC
SPRINT_WEEKS=2
SPRINT_CAPACITY_HOURS=240

# Stage 7: agents build the scaffold and first modules only. Tickets up to this sprint are built by
# agents; human developers take over the rest.
BUILD_MAX_SPRINT=1
